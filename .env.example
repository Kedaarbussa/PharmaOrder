# Server Configuration
PORT=3000

# Database Configuration (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pharmaorder?retryWrites=true&w=majority

# Google OAuth Configuration (Google Identity Services Client ID)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long

# Optional Cron Cleanup Secret (for securing Vercel Cron endpoint)
CRON_SECRET=your_optional_cron_secret_key
